from nba_api.stats.static import players, teams
from nba_api.stats.endpoints import (
    commonplayerinfo,
    playergamelog,
    teamgamelog,
    playbyplayv3
)

import pandas as pd
import time
import random

# ================== INPUT ==================
search_type = input("Player (P) or Team (T)? >> ").strip().upper()

if search_type == "P":
    search_name = input("Enter the player name >> ").strip()

elif search_type == "T":
    search_name = input("Enter the team name >> ").strip()

else:
    print("❌ Invalid choice.")
    exit()

# ===========================================

results = []
max_results = 10
search_order = ["Playoffs", "Regular Season"]

# =========================================================
# ===================== PLAYER MODE =======================
# =========================================================

if search_type == "P":

    print(f"\nSearching for player: {search_name}\n")

    # Step 1: Get Player ID
    player_list = players.find_players_by_full_name(search_name)

    if not player_list:
        print("❌ Player not found.")
        exit()

    legacy_id = player_list[0]['id']
    full_name = player_list[0]['full_name']

    try:
        player_info = commonplayerinfo.CommonPlayerInfo(player_id=legacy_id)
        df_info = player_info.get_data_frames()[0]
        person_id = int(df_info['PERSON_ID'].iloc[0])

        print(f"✅ Found {full_name} (Person ID: {person_id})\n")

    except Exception as e:
        print(f"Error getting player info: {e}")
        exit()

    print(f"Scanning for the last {max_results} times this player scored the first basket...\n")

    for season_type in search_order:

        if len(results) >= max_results:
            break

        print(f"→ Scanning {season_type} (2025-26)...")

        try:
            gamelog = playergamelog.PlayerGameLog(
                player_id=legacy_id,
                season="2025-26",
                season_type_all_star=season_type
            )

            games_df = gamelog.get_data_frames()[0]

        except:
            print(f"   Could not fetch {season_type} games.")
            continue

        if games_df.empty:
            print(f"   No {season_type} games found.\n")
            continue

        for _, row in games_df.iterrows():

            if len(results) >= max_results:
                break

            game_id = row['Game_ID']
            game_date = row['GAME_DATE']
            matchup = row['MATCHUP']

            print(f"   Checking {game_date} ({matchup})...", end=" ")

            try:
                pbp = playbyplayv3.PlayByPlayV3(game_id=game_id)
                df = pbp.get_data_frames()[0]

                made_shots = df[
                    (df['isFieldGoal'] == 1) &
                    (df['shotResult'] == 'Made')
                ]

                if not made_shots.empty:

                    first = made_shots.iloc[0]

                    if int(first['personId']) == person_id:

                        print("✅ FIRST BASKET!")

                        results.append({
                            'date': game_date,
                            'matchup': matchup,
                            'season_type': season_type,
                            'player': first['playerName'],
                            'time': first['clock'],
                            'description': first['description']
                        })

                    else:
                        print("No")

                else:
                    print("No shots")

            except Exception as e:
                print("Connection error - waiting...")
                time.sleep(3)
                continue

            time.sleep(random.uniform(0.8, 1.5))

    # ================= FINAL OUTPUT =================

    print("\n" + "=" * 85)
    print(f"LAST {len(results)} TIMES {full_name.upper()} SCORED THE FIRST BASKET")
    print("=" * 85)

    if not results:
        print("No instances found.")
    else:
        for i, r in enumerate(results, 1):
            print(f"{i}. {r['date']} | {r['matchup']} | {r['season_type']}")
            print(f"   Time : {r['time']}")
            print(f"   Desc : {r['description']}")
            print("-" * 80)

# =========================================================
# ====================== TEAM MODE ========================
# =========================================================

elif search_type == "T":

    print(f"\nSearching for team: {search_name}\n")

    # Step 1: Find Team
    team_list = teams.get_teams()

    matched_team = None

    for team in team_list:

        if (
            search_name.lower() in team['full_name'].lower()
            or search_name.lower() in team['nickname'].lower()
            or search_name.lower() in team['city'].lower()
        ):
            matched_team = team
            break

    if not matched_team:
        print("❌ Team not found.")
        exit()

    team_id = matched_team['id']
    team_name = matched_team['full_name']

    print(f"✅ Found {team_name} (Team ID: {team_id})\n")

    print(f"Scanning for the last {max_results} games where this team scored the first basket...\n")

    for season_type in search_order:

        if len(results) >= max_results:
            break

        print(f"→ Scanning {season_type} (2025-26)...")

        try:
            gamelog = teamgamelog.TeamGameLog(
                team_id=team_id,
                season="2025-26",
                season_type_all_star=season_type
            )

            games_df = gamelog.get_data_frames()[0]

        except:
            print(f"   Could not fetch {season_type} games.")
            continue

        if games_df.empty:
            print(f"   No {season_type} games found.\n")
            continue

        for _, row in games_df.iterrows():

            if len(results) >= max_results:
                break

            game_id = row['Game_ID']
            game_date = row['GAME_DATE']
            matchup = row['MATCHUP']

            print(f"   Checking {game_date} ({matchup})...", end=" ")

            try:
                pbp = playbyplayv3.PlayByPlayV3(game_id=game_id)
                df = pbp.get_data_frames()[0]

                made_shots = df[
                    (df['isFieldGoal'] == 1) &
                    (df['shotResult'] == 'Made')
                ]

                if made_shots.empty:
                    print("No shots")
                    continue

                first = made_shots.iloc[0]

                # Team can appear as home or away
                scoring_team_id = int(first['teamId'])

                if scoring_team_id == team_id:

                    print(f"✅ {first['playerName']} scored first!")

                    results.append({
                        'date': game_date,
                        'matchup': matchup,
                        'season_type': season_type,
                        'player': first['playerName'],
                        'time': first['clock'],
                        'description': first['description']
                    })

                else:
                    print("Opponent scored first")

            except Exception as e:
                print("Connection error - waiting...")
                time.sleep(3)
                continue

            time.sleep(random.uniform(0.8, 1.5))

    # ================= FINAL OUTPUT =================

    print("\n" + "=" * 85)
    print(f"LAST {len(results)} TIMES {team_name.upper()} SCORED THE FIRST BASKET")
    print("=" * 85)

    if not results:
        print("No instances found.")
    else:
        for i, r in enumerate(results, 1):
            print(f"{i}. {r['date']} | {r['matchup']} | {r['season_type']}")
            print(f"   Scorer : {r['player']}")
            print(f"   Time   : {r['time']}")
            print(f"   Desc   : {r['description']}")
            print("-" * 80)
